# MySQL connection string (Prisma 7 + MariaDB adapter)
DATABASE_URL="mysql://root:password@localhost:3306/immflow"

# Required in production — use a long random string (openssl rand -base64 32)
JWT_SECRET="immflow-local-development-secret-key-123456"

# Public app URL (password reset links, Stripe redirects)
# NEXT_PUBLIC_APP_URL="https://myimmflow.com"

# Email — SMTP (Gmail, etc.) or Resend/ZeptoMail API
# Option A: SMTP (recommended for Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_FROM_NAME="ImmFlow"
# EMAIL_PROVIDER=smtp

# Option B: Resend / ZeptoMail API
# EMAIL_API_KEY="re_..."
# EMAIL_FROM="ImmFlow <noreply@myimmflow.com>"
# EMAIL_PROVIDER=resend   # or zeptomail

# Stripe billing (Phase 2 Pro + Phase C one-time translation payments)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Checkout fails closed when Stripe is absent. Explicit local simulation is opt-in:
# ALLOW_SIMULATED_PAYMENTS=false

# Upload storage root (defaults to ./uploads under the app)
# UPLOAD_ROOT="/var/lib/immflow/uploads"
# AI matcher (Phase 3) — optional; falls back to rule-based ranking without this
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Optional Tawk.to live-chat widget
# These values are the configured production widget; override them for another property.
NEXT_PUBLIC_TAWK_PROPERTY_ID="6ab499d2519a0634452b8610"
NEXT_PUBLIC_TAWK_WIDGET_ID="1k38nhnqd"

# Optional: ngrok hostname when tunneling `npm run dev` (no https:// prefix)
# NGROK_HOST="your-subdomain.ngrok-free.dev"
